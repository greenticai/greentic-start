# syntax=docker/dockerfile:1.7

# Fast2Flow routing host (ON by default). The image ships the static musl
# `greentic-fast2flow-routing-host` from the public greenticai/greentic-fast2flow
# releases at /usr/local/bin, where greentic-start's bare-name lookup finds it.
# The binary is COMMERCIAL software (license: Commercial): the image carries it,
# a pack only uses it when it declares `greentic.cap.fast2flow.v1`.
# To build the image WITHOUT it, pass an empty version:
#   --build-arg FAST2FLOW_ROUTING_HOST_VERSION=
# The final stage is then `runtime` and the fetch stage below is never run, so
# the image is the one built before this stage existed.
# Bump the version and BOTH sha256 ARGs (in the fetch stage) together.
# See docs/fast2flow-routing-host-image.md.
ARG FAST2FLOW_ROUTING_HOST_VERSION=1.1.2

FROM rust:1.95-bookworm AS build

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    musl-tools \
    build-essential \
    cmake \
    perl \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add x86_64-unknown-linux-musl

ENV CC_x86_64_unknown_linux_musl=musl-gcc
ENV CXX_x86_64_unknown_linux_musl=g++
ENV CARGO_TARGET_DIR=/tmp/target

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY i18n ./i18n
# The revision-serve webchat console embeds these at compile time via
# `include_str!("../assets/...")` (chat.html + adaptivecards.min.js), so the
# directory must be present in the build context even for a `--bin` build.
COPY assets ./assets
# Manifest declares a `perf` bench; cargo validates the path at parse time even
# for a `--bin` build, so the file must exist (it is not compiled here).
COPY benches ./benches

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/tmp/target \
    cargo build --release --target x86_64-unknown-linux-musl \
    --config 'profile.release.strip=true' --bin greentic-start \
    && mkdir -p /out \
    && cp /tmp/target/x86_64-unknown-linux-musl/release/greentic-start /out/greentic-start

# cloudflared — static Go binary for the optional in-pod quick tunnel. The K8s
# deployer boots the worker with `--cloudflared on --cloudflared-binary
# /usr/local/bin/cloudflared`; greentic-start spawns it via direct `Command::new`
# (no shell, distroless-safe) to obtain a public `*.trycloudflare.com` URL for
# Telegram webhook auto-registration. Pinned + sha256-verified; bump both ARGs
# together. Fetched in a throwaway stage so it never invalidates the Rust build.
FROM debian:bookworm-slim AS cloudflared
ARG CLOUDFLARED_VERSION=2026.6.1
ARG CLOUDFLARED_SHA256=5861a10a438fe8ddcfebb3b830f83966cbf193edafce0fe2eeb198fbae1f7a22
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-amd64" -o /cloudflared \
    && echo "${CLOUDFLARED_SHA256}  /cloudflared" | sha256sum -c - \
    && chmod 0755 /cloudflared

# Fast2Flow routing host — static musl build from a greentic-fast2flow release
# (asset `greentic-fast2flow-routing-host-v<ver>-<arch>-unknown-linux-musl.tar.gz`).
# Skipped when FAST2FLOW_ROUTING_HOST_VERSION is empty. The digest is the one
# pinned HERE, per arch, and checked with `sha256sum -c`; the release's own
# `.sha256` sidecar is never trusted at build time. The release repo is public,
# so the fetch is anonymous and no credential is involved.
FROM debian:bookworm-slim AS fast2flow-routing-host
ARG TARGETARCH
ARG FAST2FLOW_ROUTING_HOST_VERSION
ARG FAST2FLOW_ROUTING_HOST_SHA256_AMD64=98e6fd06fbf809e338e6512598fa491295afab5308b05a7d8509e26b939af5c7
ARG FAST2FLOW_ROUTING_HOST_SHA256_ARM64=82e40b6afecfd214aa919d8469d0f4b27bb3d3815504322ee3dd3dce5024686e
ARG FAST2FLOW_ROUTING_HOST_BASE_URL=https://github.com/greenticai/greentic-fast2flow/releases/download
RUN set -eu \
    && [ -n "${FAST2FLOW_ROUTING_HOST_VERSION}" ] \
       || { echo "FAST2FLOW_ROUTING_HOST_VERSION is empty" >&2; exit 1; } \
    && case "${TARGETARCH}" in \
      amd64) triple=x86_64-unknown-linux-musl; sha="${FAST2FLOW_ROUTING_HOST_SHA256_AMD64}" ;; \
      arm64) triple=aarch64-unknown-linux-musl; sha="${FAST2FLOW_ROUTING_HOST_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH '${TARGETARCH}'" >&2; exit 1 ;; \
    esac \
    && printf '%s' "${sha}" | grep -Eq '^[0-9a-f]{64}$' \
       || { echo "FAST2FLOW_ROUTING_HOST_SHA256_* for ${TARGETARCH} must be a 64-hex sha256" >&2; exit 1; } \
    && apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && v="${FAST2FLOW_ROUTING_HOST_VERSION#v}" \
    && asset="greentic-fast2flow-routing-host-v${v}-${triple}.tar.gz" \
    && curl -fsSL "${FAST2FLOW_ROUTING_HOST_BASE_URL}/v${v}/${asset}" -o /routing-host.tar.gz \
    && echo "${sha}  /routing-host.tar.gz" | sha256sum -c - \
    && mkdir -p /extract \
    && tar -xzf /routing-host.tar.gz -C /extract \
    && install -m 0755 /extract/greentic-fast2flow-routing-host /greentic-fast2flow-routing-host

# static-debian12:nonroot ships ca-certificates + a uid-65532 nonroot user and
# no shell. The musl-static binary needs no runtime apt layer; squashfs-tools is
# gone because bundle_ref.rs reads SquashFS in-process via `backhand` (P0.4).
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

COPY --from=build /out/greentic-start /usr/local/bin/greentic-start
COPY --from=cloudflared /cloudflared /usr/local/bin/cloudflared

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/greentic-start"]

# /usr/local/bin is on the base image's PATH (distroless static-debian12 sets
# PATH=/usr/local/sbin:/usr/local/bin:...), so greentic-start's bare-name
# lookup would find the host anyway. The absolute path is set as well so the
# lookup does not depend on a PATH an orchestrator may replace; an operator's
# own GREENTIC_FAST2FLOW_HOST_BIN still overrides it.
FROM runtime AS runtime-fast2flow-routing-host
COPY --from=fast2flow-routing-host /greentic-fast2flow-routing-host /usr/local/bin/greentic-fast2flow-routing-host
ENV GREENTIC_FAST2FLOW_HOST_BIN=/usr/local/bin/greentic-fast2flow-routing-host

# Final image: `runtime-fast2flow-routing-host` by default; plain `runtime`
# when FAST2FLOW_ROUTING_HOST_VERSION is empty. BuildKit builds only the stages
# the selected one depends on, so with an empty version the fetch stage never
# runs.
FROM runtime${FAST2FLOW_ROUTING_HOST_VERSION:+-fast2flow-routing-host}
